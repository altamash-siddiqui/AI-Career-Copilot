# ==========================================
# AI CAREER COPILOT - ENVIRONMENT VARIABLES
# ==========================================

# ==========================================
# GEMINI AI
# ==========================================

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash


# ==========================================
# INTERVIEW
# ==========================================

INTERVIEW_QUESTION_COUNT=8

# Fallback cooldowns after API quota/rate-limit errors.
GEMINI_QUOTA_COOLDOWN_SECONDS=900
ELEVENLABS_QUOTA_COOLDOWN_SECONDS=3600


# ==========================================
# ELEVENLABS
# ==========================================

ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_NAME=Sarah
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_STT_MODEL_ID=scribe_v2
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128


# ==========================================
# AUTHENTICATION SECURITY
# ==========================================

# Generate a strong random value for production.
# Example:
# python -c "import secrets; print(secrets.token_urlsafe(32))"

SECRET_KEY=your_secret_key_here

# Authentication token lifetime in seconds.
AUTH_TOKEN_MAX_AGE=3600


# ==========================================
# CORS
# ==========================================

# Comma-separated allowed frontend origins.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5000,http://localhost:5000


# ==========================================
# FLASK
# ==========================================

# false for normal/production usage.
# true only for local development/debugging.
FLASK_DEBUG=false


# ==========================================
# YOUTUBE
# ==========================================

# Optional. Leave empty if YouTube API is not being used.
YOUTUBE_API_KEY=your_youtube_api_key_here